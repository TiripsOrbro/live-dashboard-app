# Windows production profile — branch `16gb` on a powerful PC (e.g. 32–64 GB RAM).
# Copy to `.env` on this machine:
#   Copy-Item .env.server16gb.example .env
# Then set secrets (STORE_CREDENTIALS_KEY, DASHBOARD_AUTH_SECRET, etc.).
#
# Pi 4 (4 GB) production uses `.env.example` on branch `4gb` instead.
# Optional Linux EliteDesk (16 GB) notes are at the bottom.

# ── Store portal logins (MMX, LifeLenz, SMG, NSF) ──
STORE_CREDENTIALS_KEY=change-this-long-random-secret

# Chrome or Edge — leave blank to auto-detect Windows paths.
# SCRAPER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# SCRAPER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

SCRAPER_HEADLESS=true
FORECAST_SCRAPER_HEADLESS=true

# All stores in parallel (match store count in stores/.storelist; currently 12).
SCRAPER_CONCURRENCY=12
# Interval scheduler must also pick all due stores each tick (default in code is 4).
SCRAPE_BATCH_SIZE=12
SCRAPER_BLOCK_RESOURCES=true

# Full-market refresh cadence during store hours.
SCRAPE_FAST_INTERVAL_SECONDS=60

# Long scrape runs (~20 stores). Increase if workers time out.
# SCRAPE_TIMEOUT_MS=900000

# Parallel Macromatix report downloads for stock/order pipelines.
MMX_PARALLEL_BUILD_TO_REPORTS=1
MMX_FAST_REPORT_DOWNLOAD=1

# Morning / admin store jobs (defaults are 1 on Pi — leave sequential there).
DAILY_REPORTS_CONCURRENCY=6
FORECAST_STORE_CONCURRENCY=4
BACKFILL_STORE_CONCURRENCY=4

# Recycle dashboard + schedulers once each morning before daily reports (frees leaked Chromium/RAM).
MORNING_RESTART_ENABLED=1
# Default is reports hour − 1 (so 6 when FIVE_AM_REPORTS_HOUR=7).
# MORNING_RESTART_HOUR=6

# ── Dashboard ──
NODE_ENV=production
DASHBOARD_TIME_ZONE=Australia/Melbourne
# Required for stable sign-in across PM2 restarts (generate a long random string).
# DASHBOARD_AUTH_SECRET=change-this-long-random-string

# Dashboard + 12 concurrent headless browsers on 32–64 GB hosts.
PM2_DASHBOARD_MAX_MEMORY=8G
# Optional scheduler caps (defaults in ecosystem.config.cjs are Pi-sized).
# Use integer units only (PM2 rejects decimals like 1.5G).
PM2_REPORT_SCHEDULER_MAX_MEMORY=1G
PM2_FORECAST_SCHEDULER_MAX_MEMORY=1500M
# DASHBOARD_MEMORY_LOG=1

# Sales cache / refresh
# SALES_CACHE_SECONDS=300
# SALES_REFRESH_SECONDS=240
# SCRAPE_POST_CLOSE_RETAIN_HOURS=2
# CONFIRMED_EMPTY_ORDER_CHECKS=2

# Forecast scheduler (PM2 forecast-scheduler process)
# FORECAST_SCHEDULE_ENABLED=1
# FORECAST_SCHEDULE_HOUR=7
# FORECAST_SCHEDULE_WINDOW_MIN=30

# Daily reports orchestrator
# DAILY_REPORTS_ORCHESTRATOR_ENABLED=1
# FIVE_AM_REPORTS_HOUR=7
# REPORT_SUBSCRIPTIONS_DEFAULT_HOUR=7

# Alert email / webhooks (optional)
# DASHBOARD_ALERT_EMAIL=you@example.com
# DASHBOARD_SMTP_HOST=smtp.gmail.com
# DASHBOARD_SMTP_PORT=587
# DASHBOARD_SMTP_USER=you@example.com
# DASHBOARD_SMTP_PASS=your-app-password
# DASHBOARD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Optional kiosk ──
# DASHBOARD_NOLOGIN_ENABLED=1
# DASHBOARD_NOLOGIN_STORES=3811
# DASHBOARD_NOLOGIN_SECRET=change-this-long-random-string

# ── Linux EliteDesk (16 GB) fallback — only if you run Ubuntu/Debian instead ──
# SCRAPER_EXECUTABLE_PATH=/usr/bin/chromium
# SCRAPER_CONCURRENCY=4
# SCRAPE_FAST_INTERVAL_SECONDS=90
# PM2_DASHBOARD_MAX_MEMORY=1.5G
